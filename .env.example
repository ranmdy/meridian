# ─── Meridian environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_minimum_32_chars

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL that the backend CORS policy allows.
FRONTEND_URL=https://your-staging.vercel.app

# ── Chain RPC URLs ────────────────────────────────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_RPC_URL_FALLBACK=https://rpc.ankr.com/eth

BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL_FALLBACK=https://rpc.ankr.com/base

ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_URL_FALLBACK=https://rpc.ankr.com/arbitrum

BNB_RPC_URL=https://bsc-dataseed.binance.org
POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
OPT_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
AVAX_RPC_URL=https://avalanche-mainnet.infura.io/v3/YOUR_KEY
SCROLL_RPC_URL=https://rpc.scroll.io
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io

# ── Integrations ──────────────────────────────────────────────────────────────
TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_ACCOUNT=

SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_ID/meridian/version/latest

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
