# Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/meridian

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-min-32-chars

# ─── RPC Providers ────────────────────────────────────────────────────────────
# Alchemy (recommended for Ethereum, Arbitrum, Base, Optimism, Polygon)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPT_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Public / self-hosted RPCs
BNB_RPC_URL=https://bsc-dataseed.binance.org/
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
SCROLL_RPC_URL=https://rpc.scroll.io
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io

# ─── Relayer private keys ─────────────────────────────────────────────────────
# SECURITY: In production use AWS KMS or HashiCorp Vault — never plaintext keys
RELAYER_PK_ETH=0x...
RELAYER_PK_BASE=0x...
RELAYER_PK_ARB=0x...
RELAYER_PK_OPT=0x...
RELAYER_PK_BNB=0x...
RELAYER_PK_POLY=0x...
RELAYER_PK_AVAX=0x...
RELAYER_PK_SCROLL=0x...
RELAYER_PK_ZKSYNC=0x...

# ─── Router contract addresses ────────────────────────────────────────────────
ROUTER_ADDRESS_ETH=0x...
ROUTER_ADDRESS_BASE=0x...
ROUTER_ADDRESS_ARB=0x...
ROUTER_ADDRESS_OPT=0x...
ROUTER_ADDRESS_BNB=0x...
ROUTER_ADDRESS_POLY=0x...
ROUTER_ADDRESS_AVAX=0x...
ROUTER_ADDRESS_SCROLL=0x...
ROUTER_ADDRESS_ZKSYNC=0x...

# ─── Quote / DEX APIs ─────────────────────────────────────────────────────────
ONEINCH_API_KEY=
PARASWAP_API_KEY=
ZRX_API_KEY=
DEFI_LLAMA_API_KEY=

# ─── Price feeds ─────────────────────────────────────────────────────────────
PYTH_HERMES_URL=https://hermes.pyth.network   # Pyth Hermes REST (primary)

# ─── NFT metadata ─────────────────────────────────────────────────────────────
PINATA_JWT=                                   # Leave blank to use base64 data URIs in dev

# ─── Monitoring ───────────────────────────────────────────────────────────────
TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_ACCOUNT=

# ─── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                            # Optional: alert channel
