# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-minimum-32-chars

# ─── RPC URLs — primary (Alchemy) ─────────────────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BNB_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OPT_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
AVAX_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SCROLL_RPC_URL=https://scroll-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ZKSYNC_RPC_URL=https://zksync-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── RPC URLs — fallback (QuickNode) ──────────────────────────────────────────
# Sign up at https://quicknode.com — one endpoint per chain.
# Used automatically when the primary Alchemy endpoint fails or rate-limits.
QUICKNODE_API_KEY=YOUR_QUICKNODE_KEY
ETH_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.quiknode.pro/YOUR_QUICKNODE_KEY
BASE_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.base.quiknode.pro/YOUR_QUICKNODE_KEY
ARB_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.arbitrum-mainnet.quiknode.pro/YOUR_QUICKNODE_KEY
BNB_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.bsc.quiknode.pro/YOUR_QUICKNODE_KEY
POLY_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.matic.quiknode.pro/YOUR_QUICKNODE_KEY
OPT_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.optimism.quiknode.pro/YOUR_QUICKNODE_KEY
AVAX_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.avalanche-mainnet.quiknode.pro/YOUR_QUICKNODE_KEY
SCROLL_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.scroll-mainnet.quiknode.pro/YOUR_QUICKNODE_KEY
ZKSYNC_RPC_URL_FALLBACK=https://compatible-cinnabar-fire.zksync-mainnet.quiknode.pro/YOUR_QUICKNODE_KEY

# ─── Relayer wallets ──────────────────────────────────────────────────────────
# One funded EOA per chain. In production, use AWS KMS — see /backend/src/services/kms-signer
RELAYER_PRIVATE_KEY_ETH=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_BASE=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_ARB=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_BNB=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_POLY=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_OPT=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_AVAX=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_SCROLL=0xYOUR_PRIVATE_KEY
RELAYER_PRIVATE_KEY_ZKSYNC=0xYOUR_PRIVATE_KEY

# ─── Router contract addresses (set after deployment) ─────────────────────────
ROUTER_ADDRESS_ETH=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_BASE=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_ARB=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_BNB=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_POLY=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_OPT=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_AVAX=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_SCROLL=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS_ZKSYNC=0x0000000000000000000000000000000000000000

# ─── AWS KMS (production signing) ─────────────────────────────────────────────
AWS_KMS_KEY_ID_ETH=arn:aws:kms:us-east-1:123456789:key/your-key-id
AWS_REGION=us-east-1

# ─── Swap quote APIs ──────────────────────────────────────────────────────────
ONEINCH_API_KEY=YOUR_1INCH_KEY
PARASWAP_API_KEY=YOUR_PARASWAP_KEY
ZRX_API_KEY=YOUR_ZRX_KEY

# ─── APY data ─────────────────────────────────────────────────────────────────
DEFI_LLAMA_API_KEY=YOUR_DEFILLAMA_KEY

# ─── The Graph ────────────────────────────────────────────────────────────────
# Used for on-chain volume, strategy count, failure rate metrics dashboards.
# Sign up at https://thegraph.com/studio — create an API key.
THEGRAPH_API_KEY=YOUR_THEGRAPH_KEY

# ─── Tenderly (transaction simulation + monitoring) ───────────────────────────
# Required for /strategy/simulate endpoint.
# Sign up at https://tenderly.co — create a project, generate an access key.
TENDERLY_ACCESS_KEY=YOUR_TENDERLY_KEY
TENDERLY_PROJECT=your-project-slug
TENDERLY_ACCOUNT=your-account-slug

# ─── Stripe (subscriptions) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID
STRIPE_API_PRICE_ID=price_YOUR_API_PRICE_ID

# ─── Monitoring & Alerting ────────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT_ID
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─── Datadog metrics (DogStatsD) ──────────────────────────────────────────────
# Install the Datadog agent and set DD_AGENT_HOST to enable metrics.
# Metrics are silently dropped when DD_AGENT_HOST is not set (dev default).
DD_AGENT_HOST=localhost
DD_DOGSTATSD_PORT=8125
DD_ENV=production
DD_SERVICE=meridian-backend

# ─── Email Notifications ──────────────────────────────────────────────────────
# One of RESEND_API_KEY or SENDGRID_API_KEY enables email alerting.
# NOTIFY_EMAIL = ops team address that receives ALL strategy failure alerts.
# EMAIL_FROM   = the "from" address (must be a verified sender in your provider).
RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
EMAIL_FROM=alerts@meridian.finance
NOTIFY_EMAIL=ops@meridian.finance

# ─── Stripe metered billing ────────────────────────────────────────────────────
# For Business API usage-based billing — set the meter event name defined in
# your Stripe Dashboard (Billing > Meters).
STRIPE_API_METER_EVENT=api_requests

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
