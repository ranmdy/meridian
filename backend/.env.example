# Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/meridian

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# RPC Providers (Alchemy recommended)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BNB_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Relayer wallets (use AWS KMS in production — never plaintext)
RELAYER_PK_ETH=0x...
RELAYER_PK_BASE=0x...
RELAYER_PK_ARB=0x...
RELAYER_PK_BNB=0x...
RELAYER_PK_POLY=0x...

# Monitoring
TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_ACCOUNT=

# Quote APIs
ONEINCH_API_KEY=
PARASWAP_API_KEY=
ZRX_API_KEY=
DEFI_LLAMA_API_KEY=

# Payments (Phase 2)
STRIPE_SECRET_KEY=sk_test_...
