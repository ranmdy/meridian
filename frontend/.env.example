NEXT_PUBLIC_ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_BNB_RPC_URL=https://bsc-dataseed.binance.org/
NEXT_PUBLIC_POLY_RPC_URL=https://polygon-rpc.com/
