{
  "name": "@meridian/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Meridian cross-chain DeFi routing engine",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev":   "tsup src/index.ts --format esm,cjs --dts --watch",
    "test":  "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup":    "^8.0.0",
    "vitest":  "^3.0.0",
    "viem":    "^2.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["meridian", "defi", "cross-chain", "routing", "yield"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meridian-finance/meridian"
  }
}
